{
  "name": "dsh-tps-splitter",
  "version": "0.1.0",
  "description": "Splits DeepSeek Harness's native session-wide tok/s calculation into per-model readings.",
  "type": "module",
  "license": "MIT",
  "author": "NanQing233",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NanQing233/dsh-tps-splitter.git"
  },
  "homepage": "https://github.com/NanQing233/dsh-tps-splitter#readme",
  "bugs": {
    "url": "https://github.com/NanQing233/dsh-tps-splitter/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "tokens-per-second",
    "tps-splitter",
    "per-model",
    "cordis",
    "speedometer"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
